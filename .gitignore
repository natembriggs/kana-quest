.DS_Store
*.log
__pycache__/

# Claude Code per-user/per-machine settings — not meant to be shared.
.claude/settings.local.json

# Downloaded by tools/fetch_kanji_sources.sh (KANJIDIC2/JMdict, ~90MB) and
# tools/fetch_kanjivg.sh (KanjiVG stroke SVGs, ~13MB) — large, regenerable,
# CC BY-SA data that shouldn't be duplicated into this repo. The build_*.py
# scripts read these and write the much smaller src/kanji-data.js and
# src/stroke-data.js, which ARE committed.
tools/data_src/

# sync-server/ (sync-plan.md) is a separate Cloudflare Worker project —
# its own dependency tree and local dev/deploy state, neither of which
# belongs in the repo.
sync-server/node_modules/
sync-server/.wrangler/
sync-server/.dev.vars

# feedback-server/ (feedback-plan.md) — a second Cloudflare Worker project,
# same reasoning as sync-server/ above. `.dev.vars` in particular holds the
# GitHub token, the receipt pepper and the webhook/release secrets.
feedback-server/node_modules/
feedback-server/.wrangler/
feedback-server/.dev.vars

# Wrangler scratch state from running d1/deploy commands at the repo root.
.wrangler/
